# Maven build output — regenerated by `mvn compile`/`mvn test`, never commit it
target/

# IDE-specific folders
.idea/
*.iml
.vscode/

# OS-specific junk
.DS_Store
Thumbs.db

# Runtime-generated data — these should stay OUT of git; they're per-node
# local state (WAL files, snapshots), not source code
wal/*.wal
snapshots/*.snapshot
